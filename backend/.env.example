SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Neon PostgreSQL
DB_URL=jdbc:postgresql://HOST/DB_NAME?sslmode=require
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=CHANGE_ME

# JWT - use a cryptographically secure random secret in real environments
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# Optional bootstrap Super Admin (override in local .env only)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUNNING

# Cloudinary
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME

# AI service connection
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=CHANGE_ME

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

