APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# Internal service authentication (shared only with Spring Boot backend)
AI_SERVICE_API_KEY=CHANGE_ME
AI_ENABLED=true

# PostgreSQL - direct read/vector connection if configured
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# Provider selection (gemini | openai | local)
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Retrieval
VECTOR_TOP_K=8
FULL_TEXT_TOP_K=8

# Processing limits
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=500

